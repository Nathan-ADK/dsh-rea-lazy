  "author": "Nathan-ADK",
  "type": "commonjs",
  "files": [
    "lib/",
    "catalog/mcp-rea.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nathan-ADK/dsh-rea-lazy.git"
  },
  "homepage": "https://github.com/Nathan-ADK/dsh-rea-lazy#readme",
  "engines": {
    "node": ">=18"
  },
  "main": "lib/index.js",
