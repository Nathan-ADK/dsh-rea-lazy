{
  "name": "@nathan-adk/dsh-rea-lazy",
  "version": "1.1.2",
  "description": "On-demand REA for DeepSeek Harness: auto-detects the local REA executable and registers it as a lazy capability, so 263 REA tools stay searchable while rea mcp never runs in the background. DSH-only.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "rea",
    "reverse-engineering",
    "mcp",
    "lazy",
    "on-demand",
    "token-saving"
  ],
  "license": "MIT",
  "author": "Nathan-ADK",
  "type": "commonjs",
  "files": [
    "lib/",
    "catalog/mcp-rea.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@kirkchinese/dsh-capability-catalog": "^0.2.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nathan-ADK/dsh-rea-lazy.git"
  },
  "homepage": "https://github.com/Nathan-ADK/dsh-rea-lazy#readme",
  "engines": {
    "node": ">=18"
  },
  "main": "lib/index.js"
}
